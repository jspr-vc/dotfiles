root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Lua matches stylua.toml, shell scripts already use 4
[*.{lua,sh}]
indent_size = 4

# Written by caelestia itself
[config/caelestia/**.json]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
