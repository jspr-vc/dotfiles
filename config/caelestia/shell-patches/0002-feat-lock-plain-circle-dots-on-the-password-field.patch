From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jasper Concepcion <jasper@jspr.vc>
Date: Thu, 24 Sep 2026 00:02:18 +0800
Subject: [PATCH 2/3] feat(lock): plain circle dots on the password field

---
 modules/lock/center/InputField.qml | 79 ++++++------------------------
 1 file changed, 16 insertions(+), 63 deletions(-)

diff --git a/modules/lock/center/InputField.qml b/modules/lock/center/InputField.qml
index ce27e99..54db6d2 100644
--- a/modules/lock/center/InputField.qml
+++ b/modules/lock/center/InputField.qml
@@ -18,14 +18,6 @@ Item {
     readonly property alias placeholderWidth: nonAnimPlaceholder.width
     property string buffer
     property bool showPassword
-    readonly property list<int> shapeQueue: {
-        const shapes = [MaterialShape.Slanted, MaterialShape.Arch, MaterialShape.Fan, MaterialShape.Arrow, MaterialShape.SemiCircle, MaterialShape.Triangle, MaterialShape.Diamond, MaterialShape.ClamShell, MaterialShape.Pentagon, MaterialShape.Gem, MaterialShape.Sunny, MaterialShape.VerySunny, MaterialShape.Cookie4Sided, MaterialShape.Ghostish, MaterialShape.SoftBurst];
-        for (let i = shapes.length - 1; i > 0; i--) {
-            const j = Math.floor(Math.random() * (i + 1));
-            [shapes[i], shapes[j]] = [shapes[j], shapes[i]];
-        }
-        return shapes;
-    }
 
     clip: true
 
@@ -126,6 +118,7 @@ Item {
         required property int index
         property real nonAnimWidthScale: 1
 
+        implicitWidth: charList.implicitHeight
         implicitHeight: charList.implicitHeight
 
         ListView.onRemove: {
@@ -133,65 +126,24 @@ Item {
             removeAnim.start();
         }
 
-        SequentialAnimation {
+        ParallelAnimation {
             id: initAnim
 
             running: true
 
-            ParallelAnimation {
-                Anim {
-                    target: char
-                    property: "opacity"
-                    from: 0
-                    to: 1
-                    type: Anim.DefaultEffects
-                }
-                Anim {
-                    target: char
-                    property: "scale"
-                    from: 0
-                    to: 1
-                    type: Anim.FastSpatial
-                }
-                Anim {
-                    target: char
-                    property: "implicitWidth"
-                    from: charList.implicitHeight
-                    to: charList.implicitHeight * 1.3
-                    type: Anim.DefaultEffects
-                }
-                PropertyAction {
-                    target: char
-                    property: "nonAnimWidthScale"
-                    value: 1.5
-                }
-            }
-            PauseAnimation {
-                duration: 180 * Tokens.anim.durations.scale
-            }
-            PropertyAction {
-                target: charShape
-                property: "shape"
-                value: MaterialShape.Circle
+            Anim {
+                target: char
+                property: "opacity"
+                from: 0
+                to: 1
+                type: Anim.DefaultEffects
             }
-            ParallelAnimation {
-                Anim {
-                    target: charShape
-                    property: "scale"
-                    to: 2 / 3
-                    type: Anim.FastSpatial
-                }
-                Anim {
-                    target: char
-                    property: "implicitWidth"
-                    to: charList.implicitHeight
-                    type: Anim.DefaultEffects
-                }
-                PropertyAction {
-                    target: char
-                    property: "nonAnimWidthScale"
-                    value: 1
-                }
+            Anim {
+                target: char
+                property: "scale"
+                from: 0
+                to: 1
+                type: Anim.FastSpatial
             }
         }
 
@@ -228,7 +180,8 @@ Item {
 
             anchors.centerIn: parent
             implicitSize: charList.implicitHeight * 1.5
-            shape: root.shapeQueue[char.index % root.shapeQueue.length] ?? MaterialShape.Circle
+            scale: 2 / 3
+            shape: MaterialShape.Circle
             color: Colours.palette.m3onSurface
 
             opacity: root.showPassword ? 0 : 1
