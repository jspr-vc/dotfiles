From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jasper <jasper@jspr.vc>
Date: Tue, 18 Aug 2026 19:48:26 +0800
Subject: [PATCH 1/3] feat(lock): make hourly forecast show a fixed 12 hours

---
 modules/lock/weather/Forecast.qml | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/modules/lock/weather/Forecast.qml b/modules/lock/weather/Forecast.qml
index c79dbc0..3215a31 100644
--- a/modules/lock/weather/Forecast.qml
+++ b/modules/lock/weather/Forecast.qml
@@ -11,6 +11,9 @@ import qs.utils
 StyledRect {
     id: root
 
+    // Hours shown in the strip; 0 auto-fits to the available width
+    readonly property int hoursShown: 12
+
     color: Colours.layer(Colours.palette.m3surfaceContainerHigh, 2)
     radius: Tokens.rounding.extraLargeIncreased
     implicitHeight: header.anchors.margins + header.implicitHeight + Tokens.spacing.medium + layout.implicitHeight + layout.anchors.bottomMargin
@@ -50,7 +53,7 @@ StyledRect {
         spacing: Tokens.spacing.small
 
         Repeater {
-            model: CUtils.clamp(Math.floor((layout.width + layout.spacing) / (Tokens.sizes.lock.forecastItemWidth + layout.spacing)), 0, Weather.hourlyForecast.length)
+            model: CUtils.clamp(root.hoursShown > 0 ? root.hoursShown : Math.floor((layout.width + layout.spacing) / (Tokens.sizes.lock.forecastItemWidth + layout.spacing)), 0, Weather.hourlyForecast.length)
 
             ColumnLayout {
                 id: hour
