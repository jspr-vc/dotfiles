#!/usr/bin/env bash
# SDDM's Xsetup: make this machine's main monitor primary and put the pointer
# on it. The greeter has no window manager, so keyboard focus follows the
# pointer, and the login prompt is typed into whichever screen it sits on.
#
# Monitors are matched the way the Hyprland device configs match them: the
# connector names are not stable, so the desktop goes by EDID name and the
# laptop by its built-in panel.
#
# Runs as root from SDDM with DISPLAY and XAUTHORITY set, before the greeter.
set -uo pipefail

host=$(tr -d '[:space:]' </etc/hostname 2>/dev/null || true)

# "output geometry edid-name" per connected output, from xrandr --verbose.
# The name is the EDID display descriptor (tag 0xfc), up to 13 characters.
outputs() {
    xrandr --verbose | awk '
        function edid_name(hex,    d, off, i, c, name) {
            for (d = 0; d < 4; d++) {
                off = (54 + d * 18) * 2
                if (substr(hex, off + 1, 10) != "000000fc00") continue
                name = ""
                for (i = 5; i < 18; i++) {
                    c = strtonum("0x" substr(hex, off + i * 2 + 1, 2))
                    if (c == 10) break
                    name = name sprintf("%c", c)
                }
                sub(/ +$/, "", name)
                return name
            }
            return ""
        }
        function flush() {
            if (out != "") print out, geom, edid_name(hex)
            out = ""; hex = ""; inedid = 0
        }
        /^[^ \t]/ {
            flush()
            if ($2 != "connected") next
            out = $1
            geom = ($3 == "primary") ? $4 : $3
            next
        }
        out == "" { next }
        /^\tEDID:/ { inedid = 1; next }
        inedid && /^\t\t[0-9a-f]+$/ { hex = hex $1; next }
        { inedid = 0 }
        END { flush() }
    '
}

pick() {
    local out geom name
    while read -r out geom name; do
        case "$host" in
            highwind) [[ "$out" == eDP* ]] ;;
            seventh-heaven) [ "$name" = "LG ULTRAGEAR+" ] ;;
            *) false ;;
        esac && { printf '%s %s\n' "$out" "$geom"; return; }
    done < <(outputs)
}

read -r output geom < <(pick)
[ -n "${output:-}" ] || exit 0

xrandr --output "$output" --primary

# WxH+X+Y; empty when the output is connected but has no mode.
if [[ "$geom" =~ ^([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)$ ]]; then
    xdotool mousemove \
        $((BASH_REMATCH[3] + BASH_REMATCH[1] / 2)) \
        $((BASH_REMATCH[4] + BASH_REMATCH[2] / 2))
fi
exit 0
