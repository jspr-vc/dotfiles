[user]
	email = jasper@jspr.vc
	name = Jasper Concepcion
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAgOfzfxTsNr3baaOsQgF8je7wrZcURi40PGL9zgUvLv
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	syntax-theme = ansi
	navigate = true
	line-numbers = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[gpg]
	format = ssh
[gpg "ssh"]
	program = /opt/1Password/op-ssh-sign
[commit]
	gpgsign = true
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
