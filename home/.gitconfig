[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	syntax-theme = ansi
	navigate = true
	line-numbers = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[gpg]
	format = ssh
[gpg "ssh"]
	program = /opt/1Password/op-ssh-sign
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
# Identity, signing key and commit.gpgsign live here, filled in by install/dotfiles.sh.
[include]
	path = ~/.gitconfig.local
