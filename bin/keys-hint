#!/usr/bin/env bash
# Searchable cheat sheet of every keybind, generated by the Hyprland Lua
# config on each load.

set -euo pipefail

if pgrep -x fuzzel >/dev/null; then
    pkill -x fuzzel
    exit 0
fi

sheet="${XDG_STATE_HOME:-$HOME/.local/state}/hypr/keybinds.txt"

if [ ! -r "$sheet" ]; then
    caelestia shell toaster error "Keybinds" "No cheat sheet at $sheet" keyboard >/dev/null 2>&1 || true
    exit 1
fi

column -t -s $'\t' "$sheet" |
    fuzzel --dmenu --prompt "Keys " --placeholder "Search keybinds" --lines 20 --width 90 >/dev/null || true
