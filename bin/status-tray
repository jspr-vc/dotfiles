#!/usr/bin/python3
# Tray icons for desktop state the Caelestia bar has no status icon for: the
# Caelestia toggles (keep awake, do not disturb) and whether ~/dotfiles is
# behind its remote. Each icon is only in the tray while its state holds;
# hovering shows what it means, and the menu acts on it.
#
# Also tracks open notifications, since Caelestia has no IPC to dismiss one:
# SIGUSR2 closes the newest. SIGUSR1 refreshes the icons at once instead of
# waiting for the next poll.
#
# System python on purpose: it needs the distro's python-dbus and
# python-gobject, and runs as a desktop helper outside any project env.

import os
import signal
import subprocess
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path

import dbus
import dbus.bus
import dbus.lowlevel
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib, GLibUnix

ITEM_IFACE = "org.kde.StatusNotifierItem"
ITEM_PATH = "/StatusNotifierItem"
MENU_IFACE = "com.canonical.dbusmenu"
MENU_PATH = "/MenuBar"
WATCHER = "org.kde.StatusNotifierWatcher"
NOTIFS = "org.freedesktop.Notifications"
POLL_SECONDS = 3
FETCH_SECONDS = 30 * 60
REPO = Path(os.environ.get("DOTFILES") or Path.home() / "dotfiles")

MENU_LABEL, MENU_SEPARATOR, MENU_ACTION = 1, 2, 3


@dataclass(frozen=True)
class Status:
    key: str
    title: str
    action: str
    icon: str
    detail: Callable[[], str | None]
    """The tooltip's second line while the state holds, None while it does not."""
    run: Callable[[], None]


def ipc(target: str, function: str) -> str:
    result = subprocess.run(
        ["qs", "-c", "caelestia", "ipc", "call", target, function],
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def toast(level: str, title: str, message: str) -> None:
    subprocess.run(["caelestia", "shell", "toaster", level, title, message, "sync"], capture_output=True)


def toggle(
    key: str, title: str, description: str, action: str, icon: str, target: str, query: str, disable: str
) -> Status:
    return Status(
        key=key,
        title=title,
        action=action,
        icon=icon,
        detail=lambda: description if ipc(target, query) == "true" else None,
        run=lambda: ipc(target, disable),
    )


def git(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["git", "-C", str(REPO), *args], capture_output=True, text=True)


def branch() -> str:
    return git("symbolic-ref", "--short", "HEAD").stdout.strip()


def dotfiles_detail() -> str | None:
    head = branch()
    behind = git("rev-list", "--count", f"HEAD..origin/{head}").stdout.strip() if head else ""
    if not behind.isdigit() or int(behind) == 0:
        return None
    return f"{behind} commit{'' if behind == '1' else 's'} behind origin/{head}"


def dotfiles_pull() -> None:
    head = branch()
    result = git("merge", "--ff-only", "--autostash", f"origin/{head}")
    # --autostash exits 0 even when reapplying the local changes conflicts, so
    # the unmerged paths are the only way to tell that it left a mess behind.
    if git("diff", "--name-only", "--diff-filter=U").stdout.strip():
        toast("error", "Dotfiles updated, with conflicts", "Autostashed changes need resolving by hand")
    elif result.returncode == 0:
        toast("success", "Dotfiles updated", f"Now level with origin/{head}")
    else:
        toast("error", "Pull failed", f"Not a fast-forward from origin/{head}")


def dotfiles_fetch() -> bool:
    GLib.spawn_async(
        ["dotfiles-check", "--fetch"],
        flags=GLib.SpawnFlags.SEARCH_PATH | GLib.SpawnFlags.STDOUT_TO_DEV_NULL | GLib.SpawnFlags.STDERR_TO_DEV_NULL,
    )
    return True


STATUSES = [
    toggle(
        key="idle",
        title="Keeping the screen awake",
        description="The screen won't dim, lock or sleep",
        action="Let the screen sleep",
        icon="caffeine-cup-full",
        target="idleInhibitor",
        query="isEnabled",
        disable="disable",
    ),
    toggle(
        key="dnd",
        title="Do not disturb is on",
        description="Notification popups are hidden",
        action="Turn off do not disturb",
        icon="notifications-disabled",
        target="notifs",
        query="isDndEnabled",
        disable="disableDnd",
    ),
    Status(
        key="dotfiles",
        title="Dotfiles outdated",
        action="Pull now",
        icon="software-update-available",
        detail=dotfiles_detail,
        run=dotfiles_pull,
    ),
]


class Item(dbus.service.Object):
    def __init__(self, conn: dbus.bus.BusConnection, indicator: "Indicator") -> None:
        super().__init__(conn, ITEM_PATH)
        self.indicator = indicator

    def props(self) -> dict:
        t = self.indicator.status
        return {
            "Category": "ApplicationStatus",
            "Id": f"status-tray-{t.key}",
            "Title": t.title,
            "Status": "Active",
            "IconName": t.icon,
            "ToolTip": dbus.Struct(
                (t.icon, dbus.Array([], signature="(iiay)"), t.title, self.indicator.detail or ""),
                signature="sa(iiay)ss",
            ),
            "ItemIsMenu": False,
            "Menu": dbus.ObjectPath(MENU_PATH),
        }

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="ss", out_signature="v")
    def Get(self, interface: str, prop: str):
        return self.props()[prop]

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface: str) -> dict:
        return self.props()

    @dbus.service.method(ITEM_IFACE, in_signature="ii")
    def Activate(self, x: int, y: int) -> None:
        self.indicator.act()

    @dbus.service.method(ITEM_IFACE, in_signature="ii")
    def SecondaryActivate(self, x: int, y: int) -> None:
        self.indicator.act()

    @dbus.service.method(ITEM_IFACE, in_signature="ii")
    def ContextMenu(self, x: int, y: int) -> None:
        pass

    @dbus.service.method(ITEM_IFACE, in_signature="is")
    def Scroll(self, delta: int, orientation: str) -> None:
        pass


class Menu(dbus.service.Object):
    """The menu Caelestia pops out on hover: what the icon means, then what to do about it."""

    def __init__(self, conn: dbus.bus.BusConnection, indicator: "Indicator") -> None:
        super().__init__(conn, MENU_PATH)
        self.indicator = indicator

    @property
    def entries(self) -> dict:
        status = self.indicator.status
        return {
            MENU_LABEL: {"label": self.indicator.detail or status.title, "enabled": False},
            MENU_SEPARATOR: {"type": "separator"},
            MENU_ACTION: {"label": status.action},
        }

    def node(self, node_id: int, props: dict, children: list) -> dbus.Struct:
        return dbus.Struct(
            (dbus.Int32(node_id), dbus.Dictionary(props, signature="sv"), dbus.Array(children, signature="v")),
            signature="ia{sv}av",
        )

    @dbus.service.method(MENU_IFACE, in_signature="iias", out_signature="u(ia{sv}av)")
    def GetLayout(self, parent_id: int, depth: int, names: list):
        if parent_id in self.entries:
            return dbus.UInt32(1), self.node(parent_id, self.entries[parent_id], [])
        children = [self.node(i, p, []) for i, p in self.entries.items()]
        return dbus.UInt32(1), self.node(0, {"children-display": "submenu"}, children)

    @dbus.service.method(MENU_IFACE, in_signature="aias", out_signature="a(ia{sv})")
    def GetGroupProperties(self, ids: list, names: list) -> list:
        ids = ids or list(self.entries)
        return [
            dbus.Struct((dbus.Int32(i), dbus.Dictionary(self.entries[i], signature="sv")), signature="ia{sv}")
            for i in ids
            if i in self.entries
        ]

    @dbus.service.method(MENU_IFACE, in_signature="is", out_signature="v")
    def GetProperty(self, node_id: int, name: str):
        return self.entries[node_id][name]

    @dbus.service.method(MENU_IFACE, in_signature="isvu")
    def Event(self, node_id: int, event_id: str, data, timestamp: int) -> None:
        if node_id == MENU_ACTION and event_id == "clicked":
            self.indicator.act()

    @dbus.service.method(MENU_IFACE, in_signature="a(isvu)", out_signature="ai")
    def EventGroup(self, events: list) -> list:
        for node_id, event_id, data, timestamp in events:
            self.Event(node_id, event_id, data, timestamp)
        return dbus.Array([], signature="i")

    @dbus.service.method(MENU_IFACE, in_signature="i", out_signature="b")
    def AboutToShow(self, node_id: int) -> bool:
        return False

    @dbus.service.method(MENU_IFACE, in_signature="ai", out_signature="aiai")
    def AboutToShowGroup(self, ids: list):
        return dbus.Array([], signature="i"), dbus.Array([], signature="i")

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="ss", out_signature="v")
    def Get(self, interface: str, prop: str):
        return self.GetAll(interface)[prop]

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface: str) -> dict:
        return {
            "Version": dbus.UInt32(3),
            "TextDirection": "ltr",
            "Status": "normal",
            "IconThemePath": dbus.Array([], signature="s"),
        }


class Indicator:
    def __init__(self, status: Status) -> None:
        self.status = status
        self.detail: str | None = None
        self.conn: dbus.bus.BusConnection | None = None
        self.objects: list[dbus.service.Object] = []
        self.watcher_owner: str | None = None

    def show(self) -> None:
        # A private connection per icon, so hiding can drop it and the tray
        # sees the item's name vanish.
        conn = dbus.bus.BusConnection(dbus.bus.BUS_SESSION)
        objects = [Item(conn, self), Menu(conn, self)]
        try:
            owner = conn.get_name_owner(WATCHER)
            watcher = conn.get_object(WATCHER, "/StatusNotifierWatcher")
            watcher.RegisterStatusNotifierItem(conn.get_unique_name(), dbus_interface=WATCHER)
        except dbus.DBusException:
            self.drop(conn, objects)
            return
        self.conn, self.objects, self.watcher_owner = conn, objects, owner

    def hide(self) -> None:
        if self.conn is None:
            return
        self.drop(self.conn, self.objects)
        self.conn, self.objects, self.watcher_owner = None, [], None

    @staticmethod
    def drop(conn: dbus.bus.BusConnection, objects: list[dbus.service.Object]) -> None:
        for obj in objects:
            obj.remove_from_connection()
        conn.close()

    def watcher_restarted(self) -> bool:
        try:
            return self.conn.get_name_owner(WATCHER) != self.watcher_owner
        except dbus.DBusException:
            return True

    def refresh(self) -> None:
        self.detail = self.status.detail()
        active = self.detail is not None
        if active and self.conn is not None and self.watcher_restarted():
            self.hide()
        if active and self.conn is None:
            self.show()
        elif not active:
            self.hide()

    def act(self) -> None:
        self.status.run()
        self.refresh()


class Notifications:
    """Watches the bus for Notify replies and closes, keeping open ids in order."""

    def __init__(self) -> None:
        self.pending: set[tuple[str, int]] = set()
        self.open: list[int] = []
        self.bus = dbus.SessionBus()

        monitor = dbus.bus.BusConnection(dbus.bus.BUS_SESSION)
        monitor.add_message_filter(self.on_message)
        rules = [
            f"type='method_call',interface='{NOTIFS}',member='Notify'",
            "type='method_return'",
            f"type='signal',interface='{NOTIFS}',member='NotificationClosed'",
        ]
        monitor.call_blocking(
            "org.freedesktop.DBus",
            "/org/freedesktop/DBus",
            "org.freedesktop.DBus.Monitoring",
            "BecomeMonitor",
            "asu",
            (rules, dbus.UInt32(0)),
        )
        self.monitor = monitor

    def on_message(self, conn, msg) -> None:
        if isinstance(msg, (dbus.lowlevel.MethodCallMessage, dbus.lowlevel.SignalMessage)):
            if msg.get_interface() != NOTIFS:
                return
        if isinstance(msg, dbus.lowlevel.MethodCallMessage):
            self.pending.add((msg.get_sender(), msg.get_serial()))
        elif isinstance(msg, dbus.lowlevel.MethodReturnMessage):
            key = (msg.get_destination(), msg.get_reply_serial())
            if key in self.pending:
                self.pending.discard(key)
                notif_id = int(msg.get_args_list()[0])
                if notif_id in self.open:
                    self.open.remove(notif_id)
                self.open.append(notif_id)
        elif isinstance(msg, dbus.lowlevel.SignalMessage):
            notif_id = int(msg.get_args_list()[0])
            if notif_id in self.open:
                self.open.remove(notif_id)

    def dismiss_newest(self) -> None:
        if not self.open:
            return
        notif_id = self.open.pop()
        try:
            self.bus.call_blocking(
                NOTIFS, "/org/freedesktop/Notifications", NOTIFS, "CloseNotification", "u", (dbus.UInt32(notif_id),)
            )
        except dbus.DBusException:
            pass


def main() -> None:
    DBusGMainLoop(set_as_default=True)
    indicators = [Indicator(s) for s in STATUSES]
    notifications = Notifications()

    def refresh() -> bool:
        for indicator in indicators:
            indicator.refresh()
        return True

    def dismiss() -> bool:
        notifications.dismiss_newest()
        return True

    dotfiles_fetch()
    refresh()
    GLib.timeout_add_seconds(POLL_SECONDS, refresh)
    GLib.timeout_add_seconds(FETCH_SECONDS, dotfiles_fetch)
    GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, refresh)
    GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, dismiss)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
